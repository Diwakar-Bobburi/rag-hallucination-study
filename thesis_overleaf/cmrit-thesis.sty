% Page layout of the VTU / CMRIT project report.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cmrit-thesis}

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[sc]{mathpazo}
\renewcommand{\ttdefault}{lmtt}
\RequirePackage[a4paper,left=3.2cm,right=2.3cm,top=3.5cm,bottom=3.0cm,
                headheight=1.2cm,headsep=0.5cm,footskip=1.1cm]{geometry}
\RequirePackage{amsmath,amssymb}
\RequirePackage{setspace}
\RequirePackage{graphicx}
\RequirePackage[table]{xcolor}
\RequirePackage{array,booktabs,multirow}
\RequirePackage{caption}
\RequirePackage{enumitem}
\RequirePackage{eso-pic}
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage[titles]{tocloft}
\RequirePackage{listings}
\RequirePackage{microtype}
\RequirePackage[hypertexnames=false,colorlinks=true,linkcolor=black,citecolor=blue!60!black,
                urlcolor=blue!60!black]{hyperref}

\definecolor{ruleBrown}{HTML}{8B3A0E}
\definecolor{titleBlue}{HTML}{0000FF}
\definecolor{nameBrown}{HTML}{C08A4A}
\definecolor{deptRed}{HTML}{A80F0F}
\definecolor{litHead}{HTML}{B01717}
\definecolor{litRow}{HTML}{E6CFD3}
\definecolor{boxFill}{HTML}{F8F2EC}

\setstretch{1.15}
\setlength{\parskip}{0.45em}
\setlength{\parindent}{0pt}
\setlist[itemize]{itemsep=0.35em,topsep=0.3em}
\captionsetup{font=small,labelsep=colon,justification=justified}

% Anything still open prints in red. Search for these before submitting.
\newcommand{\tbd}[1][TBD]{\textcolor{red}{\textbf{[#1]}}}
\newcommand{\todo}[1]{\textcolor{red}{[TODO: #1]}}

% Numbers from thesis/generated/values.tex. A value that isn't final yet prints as [TBD].
\newcommand{\defval}[2]{\expandafter\def\csname val@#1\endcsname{#2}}
\newcommand{\val}[1]{\ifcsname val@#1\endcsname\csname val@#1\endcsname\else\tbd\fi}

% Logos are optional at compile time, so a missing file shows a labelled box.
\newcommand{\logo}[3]{%
  \IfFileExists{figures/#1}%
    {\includegraphics[height=#2]{figures/#1}}%
    {\fbox{\parbox[c][#2][c]{#3}{\centering\scriptsize\textcolor{red}{figures/#1}}}}}
\newcommand{\headerlogo}{%
  \IfFileExists{figures/cmrit_logo.png}{\includegraphics[height=0.95cm]{figures/cmrit_logo.png}}{}}

% Figures that exist only once the results are final.
\newcommand{\resultfigure}[2]{%
  \IfFileExists{generated/#1}%
    {\includegraphics[width=#2]{generated/#1}}%
    {\fbox{\parbox[c][3cm][c]{#2}{\centering\tbd[#1: appears when the results are final]}}}}

% Double frame on every page.
\AddToShipoutPictureBG{%
  \AtPageLowerLeft{%
    \begin{tikzpicture}[overlay]
      \draw[line width=3.2pt] (0.9cm,0.9cm) rectangle (\paperwidth-0.9cm,\paperheight-0.9cm);
      \draw[line width=0.6pt] (1.15cm,1.15cm) rectangle (\paperwidth-1.15cm,\paperheight-1.15cm);
    \end{tikzpicture}}}

% Running header and footer of the chapters.
\fancypagestyle{thesis}{%
  \fancyhf{}%
  \fancyhead[L]{\small\ThesisShortTitle}%
  \fancyhead[R]{\headerlogo}%
  \fancyfoot[L]{\small\DeptFooter}%
  \fancyfoot[C]{\small\AcademicYear}%
  \fancyfoot[R]{\small Page \thepage}%
  \renewcommand{\headrule}{{\color{ruleBrown}\hrule height 1.4pt\vskip 1pt\hrule height 0.4pt}}%
  \renewcommand{\footrule}{{\color{ruleBrown}\hrule height 1.4pt}}%
}
% Front matter: only a centred page number.
\fancypagestyle{frontmatter}{%
  \fancyhf{}%
  \fancyfoot[C]{\small\thepage}%
  \renewcommand{\headrule}{}%
  \renewcommand{\footrule}{}%
}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead[L]{\small\ThesisShortTitle}%
  \fancyhead[R]{\headerlogo}%
  \fancyfoot[L]{\small\DeptFooter}%
  \fancyfoot[C]{\small\AcademicYear}%
  \fancyfoot[R]{\small Page \thepage}%
  \renewcommand{\headrule}{{\color{ruleBrown}\hrule height 1.4pt\vskip 1pt\hrule height 0.4pt}}%
  \renewcommand{\footrule}{{\color{ruleBrown}\hrule height 1.4pt}}%
}

% "CHAPTER 1" centred, then the title in capitals on the left.
\titleformat{\chapter}[display]
  {\bfseries}
  {\filcenter\fontsize{20}{24}\selectfont CHAPTER \thechapter}
  {1em}
  {\fontsize{20}{24}\selectfont\MakeUppercase}
\titleformat{name=\chapter,numberless}[block]
  {\bfseries}{}{0pt}{\fontsize{20}{24}\selectfont\MakeUppercase}
\titlespacing*{\chapter}{0pt}{0pt}{1.4em}
\titleformat*{\section}{\Large\bfseries}
\titleformat*{\subsection}{\large\bfseries}
\titlespacing*{\section}{0pt}{1.3em}{0.7em}
\titlespacing*{\subsection}{0pt}{1.1em}{0.5em}

% Headings of the front-matter pages.
\newcommand{\frontheading}[1]{%
  \clearpage
  \phantomsection
  \addcontentsline{toc}{chapter}{#1}%
  \vspace*{1.6cm}%
  \begin{center}{\Large\bfseries\MakeUppercase{#1}}\end{center}%
  \vspace{0.6cm}}

% Table of contents and the two lists, with the column headings of the report.
\setcounter{tocdepth}{1}
\setcounter{secnumdepth}{2}
\renewcommand{\cftchapfont}{\bfseries}
\renewcommand{\cftchappagefont}{\bfseries}
\renewcommand{\cftchapleader}{\hfill}
\renewcommand{\cftsecleader}{\hfill}
\renewcommand{\cftfigleader}{\hfill}
\renewcommand{\cfttableader}{\hfill}
\setlength{\cftbeforechapskip}{0.2em}
\renewcommand{\cftfigpresnum}{Fig }
\renewcommand{\cfttabpresnum}{Table }
\setlength{\cftfignumwidth}{2.9cm}
\setlength{\cfttabnumwidth}{2.9cm}
\setlength{\cftfigindent}{0pt}
\setlength{\cfttabindent}{0pt}
\setlength{\cftbeforefigskip}{0.3em}
\setlength{\cftbeforetabskip}{0.8em}
\makeatletter
\newcommand{\thesiscontents}{%
  \frontheading{Table of contents}%
  \vspace{-0.8cm}%
  \noindent\textbf{CONTENT}\hfill\textbf{Page No.}\par\vspace{0.4em}%
  \@starttoc{toc}}
\newcommand{\thesisfigures}{%
  \frontheading{List of Figures}%
  \noindent\makebox[2.9cm][l]{\textbf{Figure No.}}\textbf{Title}\hfill\textbf{Page No.}\par\vspace{0.4em}%
  \@starttoc{lof}}
\newcommand{\thesistables}{%
  \frontheading{List of Tables}%
  \noindent\makebox[2.9cm][l]{\textbf{Table No.}}\textbf{Title}\hfill\textbf{Page No.}\par\vspace{0.4em}%
  \@starttoc{lot}}
\makeatother

% One block of the literature survey (red header row, pink body row).
\newcommand{\littable}[5]{%
  \par\noindent
  {\setlength{\tabcolsep}{4pt}\renewcommand{\arraystretch}{1.1}\small
  \begin{tabular}{|>{\raggedright\arraybackslash}p{2.5cm}|>{\raggedright\arraybackslash}p{2.6cm}%
                  |>{\raggedright\arraybackslash}p{1.75cm}|>{\raggedright\arraybackslash}p{3.8cm}%
                  |>{\raggedright\arraybackslash}p{3.25cm}|}
    \hline
    \rowcolor{litHead}
    \textcolor{white}{\textbf{Author}} & \textcolor{white}{\textbf{Title}} &
    \textcolor{white}{\textbf{Year of Publica\-tion}} & \textcolor{white}{\textbf{Techniques Used}} &
    \textcolor{white}{\textbf{Dataset Source}} \\ \hline
    \rowcolor{litRow}
    #1 & #2 & #3 & #4 & #5 \\ \hline
  \end{tabular}}\par\vspace{1em}}

